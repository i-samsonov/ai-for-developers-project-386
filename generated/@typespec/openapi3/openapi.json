              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingConfirmation": {
        "type": "object",
        "required": [
          "confirmed"
        ],
        "properties": {
          "confirmed": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "BookingSettings": {
        "type": "object",
        "required": [
          "timezone",
          "opensAt",
          "closesAt",
          "slotStepMinutes",
          "bookingWindowDays"
        ],
        "properties": {
          "timezone": {
            "type": "string",
            "enum": [
              "Europe/Moscow"
            ]
          },
          "opensAt": {
            "type": "string",
            "enum": [
              "09:00"
            ]
          },
          "closesAt": {
            "type": "string",
            "enum": [
              "18:00"
            ]
          },
          "slotStepMinutes": {
            "type": "number",
            "enum": [
              30
            ]
          },
          "bookingWindowDays": {
            "type": "number",
            "enum": [
              14
            ]
          }
        },
        "description": "Часы владельца календаря; время начала и окончания указано в Europe/Moscow."
      },
      "CreateBooking": {
        "type": "object",
        "required": [
          "eventTypeId",
          "startsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "eventTypeId": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        }
      },
      "CreateEventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 540
          }
        }
      },
      "DeleteBookingResult": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "DeleteEventTypeResult": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Slot": {
        "type": "object",
        "required": [
          "startsAt",
          "available"
        ],
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "past",
              "booked",
              "does_not_fit"
            ]
          }
        },
        "description": "Начало по получасовой сетке. Причина указывается только для недоступного слота."
      },
      "SlotsResponse": {
        "type": "object",
        "required": [
          "date",
          "slots"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Slot"
            }
          }
        }
      },
      "UpcomingBooking": {
        "type": "object",
        "required": [
          "id",
          "eventType",
          "startsAt",
          "endsAt",
          "guestName",
          "guestEmail"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "eventType": {
            "$ref": "#/components/schemas/EventType"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "guestName": {
            "type": "string"
          },
          "guestEmail": {
            "type": "string"
          }
        }
      },
      "UpdateEventType": {
        "type": "object",
        "required": [
          "name",
          "description",
          "durationMinutes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 540
          }
        }
      }
    }
  }
}
