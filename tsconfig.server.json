{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "server",
    "outDir": "dist-server",
    "strict": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["server/**/*.ts"]
}
